# Set true to preview the full UI without Supabase/Postgres.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project settings -> Connect / API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Runtime pooled connection. Supabase Transaction Pooler is recommended for Vercel.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct/session connection for Drizzle migrations. Do not use the transaction pooler here.
DATABASE_MIGRATION_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Optional seed linkage: UUID from Supabase Authentication -> Users
SEED_USER_ID=
